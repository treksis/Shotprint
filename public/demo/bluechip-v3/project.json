   "media": {
    "type": "image",
    "src": "/demo/bluechip-v3/inputs/product_sheet.jpg"
   },
   "meta": {
    "lock": "Meta VR Glasses, wrap-around smart glasses: one continuous curved glossy black glass shield (single wide visor, not two lenses) inside a thin polished silver-grey rim; a pale silver-grey brow band across the top of the front with a small Meta infinity mark in the centre and two tiny dark sensor dots on each side; thick satin dark-gunmetal temple arms with one small round black camera lens on each side just behind the shield, a warm grey-bronze lower panel on each arm and black rubber tips; a braided black cable runs from the tip of the left arm to a small flat rounded-square matte black compute puck with vent slots on its side."
   }
  },

# Copy to .env (or .dev.vars) and fill in. Only META_API_KEY is required to browse and chat.

# Meta Model API key: Muse Spark / Muse Wonder for the agent, Muse Image for stills.
META_API_KEY=

# Passcode that unlocks Live mode (Muse Wonder, paid tools) for judges. Demo mode needs none.
JUDGE_PASSCODE=

# Hard spend cap per project in USD, enforced by the server.
STUDIO_USD_CAP=3

# Video rendering (MiniMax-H3 on a GPU box reached over ssh). Off by default: without it the agent
# plans, writes, draws stills and edits, but cannot render new clips.
H3_ENABLED=0
H3_HOST=colab-h3
# H3_TOOL=sandbox/host/h3

# Optional sandbox overrides.
# STUDIO_SANDBOX_IMAGE=muse-harness
# STUDIO_SANDBOX_CPUS=2
# STUDIO_SANDBOX_MEMORY=4g

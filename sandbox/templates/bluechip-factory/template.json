  "shot_tolerance_s": 0.3,
  "lines": {
    "L1": {
      "function": "hook: heritage claim",
      "max_syllables": 14
    },
    "L2": {
      "function": "loss",
      "max_syllables": 8
    },
    "L3": {
      "function": "stakes: conditional parallelism",
      "max_syllables": 16
    },
    "L4": {
      "function": "turn + product name",
      "max_syllables": 14,
      "must_include": "{PRODUCT_NAME}"
    },
    "L5": {
      "function": "proof: made here by hand",
      "max_syllables": 12
    },
    "L6": {
      "function": "mission",
      "max_syllables": 12
    }
  },
  "rules": {
    "no_jump_cut_same_setup": true,
    "presenter_takes_start_from_setup_plate": true,
    "clip_music": "none (one score in post)",
    "hard_cuts_only": true,
    "max_effects": 1,
    "effects_allowed_on": [
      "CAM-A",
      "CAM-C"
    ],
    "legible_text_in_post_only": true,
    "min_product_frame_fraction": 0.33,
    "anchor_both_ends": true,
    "speaking_end_plate": "neutral expression, lips parted, hands low; never smile/closed lips",
    "product_lock_line": "required, pasted into every product prompt",
    "product_sheet": "assets/product_sheet.png is the authority (shape + finish)",
    "restraint": "no grins/theatrical gestures/hype delivery, no flares/glow/sparkle, moves within measured size"
  },
  "slots": [
    "PRODUCT_NAME",
    "PRODUCT_SHEET",
    "PRODUCT_MUST",
    "PRODUCT_NEVER",
    "PRESENTER",
    "VOICE",
    "CLAIM_LINE_1",
    "CLAIM_LINE_2",
    "BRAND_MARK",
    "SCORE",
    "L1",
    "L2",
    "L3",
    "L4",
    "L5",
    "L6"
  ],
  "modes": {
    "presenter_on_camera": "ref2v voice take -> fl2v picture (first=setup plate, last=end-pose plate, guide_audio=take)",
    "product": "fl2v (start + end plate, product checked on both)",
    "broll": "fl2v (start + end plate)",
    "match_on_action": "chain last frame -> next first_frame",
    "heritage_still": "plate held as still (no render)"
  }
}
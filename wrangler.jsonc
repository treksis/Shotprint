{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muse-viral-studio",
  "main": "src/worker/cf-entry.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Secrets: npx wrangler secret put JUDGE_PASSCODE / META_API_KEY (local dev: .env or .dev.vars)
  // The container below is where each project's Muse Code sandbox runs when deployed (not wired yet).
  "containers": [
    {
      "class_name": "MuseSandbox",
      "image": "./Dockerfile",
      "max_instances": 5
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SANDBOX_DO",
        "class_name": "MuseSandbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MuseSandbox"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "muse-viral-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}

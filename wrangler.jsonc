{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shotprint",
  "main": "src/worker/cf-entry.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "9f2c9553ce02bd2f9ff643540f4a847b",
  "routes": [{ "pattern": "shotprint.dev", "custom_domain": true }],
  "workers_dev": true,
  // npm run cf:deploy builds the client, packs templates/seeds (scripts/cf-pack.ts) and the VM server bundle.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/templates/proof/*", "/templates/examples/*", "/templates/samplea/*"]
  },
  // Secrets: npx wrangler secret put JUDGE_PASSCODE / META_API_KEY
  // Every project gets its own container (one microVM) running the Studio session server and Muse Code.
  "containers": [
    {
      "class_name": "ProjectVM",
      "image": "./Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PROJECT_VM", "class_name": "ProjectVM" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectVM"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shotprint-db",
      "database_id": "11301791-4cd3-43ac-b9b3-dee5422997c8"
    }
  ],
  // Benchmarks, reference ads and sample-project thumbnails: served only with the judge passcode.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "shotprint-media" }],
  // Spend guard: agents stop at $12 across all projects, $5 a project, $2.50 per VM life; 30 new projects a day.
  // STUDIO_PAUSED "1" is the kill switch. Worst case with 3 VMs mid-turn is about $12 + 3 × $2.50.
  "vars": { "GLOBAL_USD_CAP": "12", "PROJECT_USD_CAP": "5", "STUDIO_USD_CAP": "2.5", "DAILY_PROJECTS": "30", "STUDIO_PAUSED": "0" },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
